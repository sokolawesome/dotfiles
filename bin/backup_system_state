#!/usr/bin/env python3
"""Save installed packages, user groups and enabled services into the dotfiles repo."""

import argparse
import os
import subprocess
from dataclasses import dataclass
from enum import Enum
from pathlib import Path

from _common import (
    DIM,
    FAILURE,
    QUESTION,
    SUCCESS,
    console,
    plain_table,
    print_error,
    run_cli,
    show_panel,
)
from rich.markup import escape
from rich.table import Table

CHANGED = "bold yellow"


class Outcome(Enum):
    CREATED = "created"
    UPDATED = "updated"
    UNCHANGED = "unchanged"
    FAILED = "failed"


class BackupError(Exception):
    pass


@dataclass(frozen=True)
class Artifact:
    label: str
    target: Path
    content: str


@dataclass(frozen=True)
class Result:
    outcome: Outcome
    added: int = 0
    removed: int = 0
    reason: str = ""


def run_text(command: list[str]) -> str:
    label = " ".join(command)
    try:
        finished = subprocess.run(command, capture_output=True, text=True, check=False)
    except FileNotFoundError as error:
        raise BackupError(f"{label}: {error}") from error
    if finished.returncode != 0:
        detail = finished.stderr.strip().splitlines()
        reason = detail[0] if detail else f"exit {finished.returncode}"
        raise BackupError(f"{label} failed: {reason}")
    return finished.stdout


def installed_packages(foreign: bool) -> list[str]:
    origin = "-Qqem" if foreign else "-Qqen"
    return sorted(run_text(["pacman", origin]).split())


def user_groups() -> list[str]:
    return sorted(run_text(["groups"]).split())


def unit_files(system_scope: bool) -> list[str]:
    command = ["systemctl"]
    if not system_scope:
        command.append("--user")
    command += ["list-unit-files", "--state=enabled", "--no-pager", "--no-legend"]
    return [line.split()[0] for line in run_text(command).splitlines() if line.strip()]


def enabled_services() -> list[str]:
    return [
        "# system services",
        *unit_files(system_scope=True),
        "",
        "# user services",
        *unit_files(system_scope=False),
    ]


def as_lines(items: list[str]) -> str:
    return "".join(f"{item}\n" for item in items)


def collect(target: Path) -> list[Artifact]:
    other = target / "other"
    return [
        Artifact(
            "official pacman packages",
            other / "pacman-packages.txt",
            as_lines(installed_packages(foreign=False)),
        ),
        Artifact(
            "aur packages",
            other / "yay-packages.txt",
            as_lines(installed_packages(foreign=True)),
        ),
        Artifact("user groups", other / "user-groups.txt", as_lines(user_groups())),
        Artifact(
            "enabled services",
            other / "enabled-services.txt",
            as_lines(enabled_services()),
        ),
    ]


def count_changes(new: str, old: str) -> tuple[int, int]:
    before = set(old.splitlines())
    after = set(new.splitlines())
    return len(after - before), len(before - after)


def write_atomically(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(content)
    os.replace(temporary, path)


def apply(artifact: Artifact, dry_run: bool) -> Result:
    if artifact.target.is_file():
        current = artifact.target.read_text()
        if current == artifact.content:
            return Result(Outcome.UNCHANGED)
        outcome = Outcome.UPDATED
    else:
        current = ""
        outcome = Outcome.CREATED

    added, removed = count_changes(artifact.content, current)
    if not dry_run:
        try:
            write_atomically(artifact.target, artifact.content)
        except OSError as error:
            return Result(Outcome.FAILED, added, removed, str(error))
    return Result(outcome, added, removed)


def describe(result: Result) -> str:
    if result.outcome is Outcome.UNCHANGED:
        return ""
    if result.outcome is Outcome.FAILED:
        return result.reason
    return f"{result.added} added, {result.removed} removed"


def build_table(rows: list[tuple[Artifact, Result]]) -> Table:
    table = plain_table()
    table.add_column(overflow="ellipsis")
    table.add_column(justify="right", width=9)
    table.add_column(overflow="fold")
    styles = {
        Outcome.CREATED: SUCCESS,
        Outcome.UPDATED: CHANGED,
        Outcome.UNCHANGED: DIM,
        Outcome.FAILED: FAILURE,
    }
    for artifact, result in rows:
        table.add_row(
            escape(artifact.label),
            f"[{styles[result.outcome]}]{result.outcome.value}[/]",
            f"[{DIM}]{escape(describe(result))}[/]",
        )
    return table


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    if not args.dotfiles.is_dir():
        print_error(f"not a directory: {args.dotfiles}")
        return 1

    try:
        artifacts = collect(args.dotfiles)
    except BackupError as error:
        print_error(str(error))
        return 1

    rows = [(artifact, apply(artifact, args.diff)) for artifact in artifacts]
    failures = sum(1 for _, result in rows if result.outcome is Outcome.FAILED)

    if args.diff:
        show_panel(build_table(rows), "would change", QUESTION)
        return 1 if failures else 0

    show_panel(build_table(rows), "backup")

    if failures:
        console.print(f"\n[{FAILURE}]{failures} file(s) could not be written[/]")
        return 1

    written = sum(
        1 for _, result in rows if result.outcome in (Outcome.CREATED, Outcome.UPDATED)
    )
    if written:
        console.print(f"\n[{SUCCESS}]{written} file(s) written[/]")
    else:
        console.print(f"\n[{DIM}]no changes[/]")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="backup_system_state",
        description="save installed packages, user groups and enabled services into the dotfiles repo",
    )
    parser.add_argument(
        "-d",
        "--diff",
        action="store_true",
        help="report what would change without writing",
    )
    parser.add_argument(
        "--dotfiles",
        type=Path,
        default=Path(
            os.environ.get("DOTFILES_PATH", Path(__file__).resolve().parents[1])
        ),
        help="dotfiles repo root, defaults to DOTFILES_PATH or the parent of this script",
    )
    return parser


if __name__ == "__main__":
    run_cli(main)
