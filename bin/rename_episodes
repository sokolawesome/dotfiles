#!/usr/bin/env python3
"""Bulk rename tv show episodes to S01E01 format."""

import argparse
import re
from dataclasses import dataclass
from pathlib import Path

from rich.console import Console
from rich.markup import escape
from rich.panel import Panel
from rich.prompt import Confirm
from rich.table import Table

console = Console()

QUESTION = "bold cyan"
RENAMED = "bold green"
SKIPPED = "yellow"
FAILED = "red"
DIM = "dim"

SEASON_WIDTH = 2
EPISODE_WIDTH = 2

VIDEO_SUFFIXES = (".mkv", ".mp4", ".avi")
AUDIO_SUFFIXES = (".mka", ".ac3", ".eac3", ".flac", ".aac")
SUBTITLE_SUFFIXES = (".ass", ".srt", ".vtt", ".sub")
MEDIA_SUFFIXES = VIDEO_SUFFIXES + AUDIO_SUFFIXES + SUBTITLE_SUFFIXES

LANGUAGE_CODES = (
    "en", "eng",
    "ru", "rus",
    "es", "spa",
    "ja", "jpn",
)

QUALITY_WORDS = (
    "bdrip", "webrip", "web.dl", "bluray", "x264", "x265", "hevc", "avc",
    "flac", "aac", "ac3", "eac3", "dts", "opus", "10bit", "8bit",
)
RESOLUTION_WORDS = (r"[0-9]{3,4}p", r"[0-9]{4}x[0-9]{3,4}")
QUALITY_ALTERNATION = "|".join(QUALITY_WORDS + RESOLUTION_WORDS)

BRACKETED_TAG = re.compile(rf"\[([^\]]*(?:{QUALITY_ALTERNATION})[^\]]*)\]", re.IGNORECASE)
PAREN_TAG = re.compile(rf"\(([^)]*(?:{QUALITY_ALTERNATION})[^)]*)\)", re.IGNORECASE)
BARE_TAG = re.compile(rf"\b(?:{QUALITY_ALTERNATION})\b", re.IGNORECASE)

DOTTED_SEASON_EPISODE = re.compile(r"S([0-9]{1,2})\.E([0-9]{1,3})", re.IGNORECASE)
JOINED_SEASON_EPISODE = re.compile(r"S([0-9]{1,2})E([0-9]{1,3})", re.IGNORECASE)
SEASON_EPISODE_X = re.compile(r"([0-9]{1,2})x([0-9]{1,3})")
BRACKETED_NUMBER = re.compile(r"\[([0-9]{1,3})\]")
DASHED_NUMBER = re.compile(r" - ([0-9]{1,3})[ .]")
TRAILING_NUMBER = re.compile(r"[ -]([0-9]{1,3})$")
LEADING_NUMBER = re.compile(r"^([0-9]{1,3})[\. ]")
MIDDLE_NUMBER = re.compile(r" ([0-9]{1,3}) ")

ALPHA_SEGMENT = re.compile(r"^[A-Za-z]+$")

SEASON_IN_NAME = re.compile(r"season[\s._-]*([0-9]+)", re.IGNORECASE)

ABSOLUTE_SEASON = "00"
UNDETECTED = object()


@dataclass(frozen=True)
class NumberPattern:
    season_group: int | None
    episode_group: int
    pattern: re.Pattern


@dataclass(frozen=True)
class Episode:
    source: Path
    season: str
    number: str
    target: str

    @property
    def settled(self) -> bool:
        return self.target == self.source.name

    def rename(self) -> Path:
        return self.source.with_name(self.target)


LADDER = (
    NumberPattern(1, 2, DOTTED_SEASON_EPISODE),
    NumberPattern(1, 2, JOINED_SEASON_EPISODE),
    NumberPattern(1, 2, SEASON_EPISODE_X),
    NumberPattern(None, 1, BRACKETED_NUMBER),
    NumberPattern(None, 1, DASHED_NUMBER),
    NumberPattern(None, 1, TRAILING_NUMBER),
    NumberPattern(None, 1, LEADING_NUMBER),
    NumberPattern(None, 1, MIDDLE_NUMBER),
)


def plural(count: int, word: str) -> str:
    return f"{count} {word}" if count == 1 else f"{count} {word}s"


def pad(digits: str, width: int) -> str:
    return f"{int(digits):0{width}d}"


def strip_extension(name: str) -> str:
    return re.sub(r"\.[^.]+$", "", name)


def normalize_dots(name: str) -> str:
    if " " in name:
        return name
    return name.replace(".", " ")


def normalize_underscores(name: str) -> str:
    return name.replace("_", " ")


def strip_quality_tags(name: str) -> str:
    without_brackets = BRACKETED_TAG.sub("", name)
    without_parens = PAREN_TAG.sub("", without_brackets)
    return BARE_TAG.sub("", without_parens).strip()


def normalize_name(name: str) -> str:
    without_extension = strip_extension(name)
    dotted = normalize_dots(without_extension)
    underscored = normalize_underscores(dotted)
    return strip_quality_tags(underscored)


def match_number(name: str) -> tuple[str, str] | None:
    dotted = DOTTED_SEASON_EPISODE.search(name)
    if dotted:
        return pad(dotted.group(1), SEASON_WIDTH), pad(dotted.group(2), EPISODE_WIDTH)

    normalized = normalize_name(name)
    for rung in LADDER:
        match = rung.pattern.search(normalized)
        if match:
            if rung.season_group is None:
                season = ABSOLUTE_SEASON
            else:
                season = pad(match.group(rung.season_group), SEASON_WIDTH)
            return season, pad(match.group(rung.episode_group), EPISODE_WIDTH)
    return None


def trailing_tags(stem: str) -> str:
    segments = stem.split(".")
    language = None
    for index in range(1, len(segments)):
        if segments[index].lower() in LANGUAGE_CODES:
            language = index
    if language is None:
        return ""
    last = language
    while last + 1 < len(segments) and ALPHA_SEGMENT.match(segments[last + 1]):
        last += 1
    tags = [
        segment.lower() if index == language else segment
        for index, segment in enumerate(segments[language : last + 1], start=language)
    ]
    return "." + ".".join(tags)


def target_suffix(name: str) -> str:
    for suffix in MEDIA_SUFFIXES:
        if name.endswith(suffix):
            break
    else:
        return ""
    return f"{trailing_tags(name[: -len(suffix)])}{suffix}"


def detect_season(directory_name: str) -> str | None:
    match = SEASON_IN_NAME.search(directory_name)
    if not match:
        return None
    return pad(match.group(1), SEASON_WIDTH)


def scan_media_files(directory: Path) -> list[Path]:
    candidates = [p for p in directory.iterdir() if p.is_file()]
    return sorted(p for p in candidates if p.name.endswith(MEDIA_SUFFIXES))


def resolve_season(argument: str | None, directory: Path) -> str | None:
    if argument is not None:
        return pad(argument, SEASON_WIDTH)
    return detect_season(directory.resolve().name)


def resolve_number(number: str, offset: int) -> int:
    return int(number) + offset


def resolve_season_for_file(found_season: str, detected_season: str) -> str:
    if found_season == ABSOLUTE_SEASON:
        return detected_season
    return found_season


def classify(
    paths: list[Path],
    season: str,
    episode_offset: int,
) -> tuple[list[Episode], list[Path]]:
    episodes = []
    skipped = []
    for path in paths:
        parsed = match_number(path.name)
        suffix = target_suffix(path.name)
        if parsed is None or not suffix:
            skipped.append(path)
            continue
        found_season, found_number = parsed
        final_season = resolve_season_for_file(found_season, season)
        number = resolve_number(found_number, episode_offset)
        if number < 1:
            skipped.append(path)
            continue
        target = f"S{final_season}E{pad(str(number), EPISODE_WIDTH)}{suffix}"
        episodes.append(Episode(path, final_season, str(number), target))
    return episodes, skipped


def find_collisions(episodes: list[Episode]) -> list[tuple[str, Path, Path]]:
    claimed: dict[str, Path] = {}
    collisions = []
    for episode in episodes:
        previous = claimed.setdefault(episode.target, episode.source)
        if previous is not episode.source:
            collisions.append((episode.target, previous, episode.source))
    return collisions


def build_preview(episodes: list[Episode]) -> Table:
    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(overflow="ellipsis")
    table.add_column(justify="center", width=1)
    table.add_column(overflow="ellipsis")
    for episode in episodes:
        if episode.settled:
            table.add_row(escape(episode.source.name), "·", f"[{DIM}]unchanged[/]")
        else:
            table.add_row(escape(episode.source.name), "→", f"[{RENAMED}]{escape(episode.target)}[/]")
    return table


def build_skipped(skipped: list[Path]) -> Table:
    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(overflow="ellipsis")
    for path in skipped:
        table.add_row(f"[{SKIPPED}]{escape(path.name)}[/]")
    return table


def show_preview(episodes: list[Episode], skipped: list[Path]) -> None:
    console.print(Panel(build_preview(episodes), title="preview", border_style="cyan", padding=(0, 1)))
    if skipped:
        console.print(Panel(build_skipped(skipped), title="skipped", border_style="yellow", padding=(0, 1)))
    settled = sum(1 for episode in episodes if episode.settled)
    summary = f"{len(episodes)} files"
    if settled:
        summary += f", {settled} already named"
    if skipped:
        summary += f", {len(skipped)} skipped"
    console.print(f"[{QUESTION}]{summary}[/]\n")


def show_collisions(collisions: list[tuple[str, Path, Path]]) -> None:
    console.print("\n[red]error:[/] two files resolve to the same name")
    for target, first, second in collisions:
        console.print(f"  [red]{escape(target)}[/] from [dim]{escape(first.name)}[/] and [dim]{escape(second.name)}[/]")


def apply_renames(episodes: list[Episode]) -> int:
    failures = 0
    for episode in episodes:
        try:
            episode.source.rename(episode.rename())
        except OSError as error:
            console.print(f"  [{FAILED}]x[/] {escape(episode.source.name)}: {escape(str(error))}")
            failures += 1
        else:
            console.print(f"  [{RENAMED}]+[/] {escape(episode.source.name)} [dim]->[/] {escape(episode.target)}")
    return failures


def report(done: str) -> None:
    console.print(f"\n[{RENAMED}]{done}[/]")


def confirm(question: str) -> bool:
    return Confirm.ask(f"[{QUESTION}]{question}[/]", default=False, console=console)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rename_episodes",
        description="rename episode files in the current directory to S01E01 format",
    )
    parser.add_argument("-s", "--season", type=int, help="season number, detected from the directory name if absent")
    parser.add_argument("-o", "--offset", type=int, default=0, help="add this to every episode number")
    parser.add_argument("--absolute", action="store_true", help="treat episode numbers as absolute, subtract --offset from them")
    parser.add_argument("-d", "--directory", type=Path, default=Path("."), help="directory to scan")
    return parser


def main(argv: list[str] | None = None) -> int:
    try:
        return run(argv)
    except (KeyboardInterrupt, EOFError):
        console.print("\n[yellow]cancelled[/]")
        return 130


def run(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    directory = args.directory

    if not directory.is_dir():
        console.print(f"[red]error:[/] {escape(str(directory))} is not a directory")
        return 1

    season = resolve_season(None if args.season is None else str(args.season), directory)
    if season is None:
        console.print("[red]error:[/] could not detect season from the directory name")
        console.print("[dim]       use -s/--season to specify[/]")
        return 1
    if args.season is None:
        console.print(f"[{QUESTION}]detected season {season}[/] from directory name\n")

    paths = scan_media_files(directory)
    if not paths:
        console.print("[red]error:[/] no media files found in current directory")
        return 1

    absolute_base = args.offset if args.absolute else None
    episode_offset = 0 if absolute_base is None else absolute_base
    episodes, skipped = classify(paths, season, episode_offset)

    if not episodes:
        console.print("[red]error:[/] could not extract episode numbers from any files")
        return 1

    pending = [episode for episode in episodes if not episode.settled]
    if not pending:
        console.print(f"[{RENAMED}]nothing to rename[/], {plural(len(episodes), 'file')} already named")
        return 0

    show_preview(episodes, skipped)

    collisions = find_collisions(episodes)
    if collisions:
        show_collisions(collisions)
        return 1

    if not confirm("proceed?"):
        console.print("[yellow]cancelled[/]")
        return 1

    failures = apply_renames(pending)

    if failures == 0:
        report(f"done - {plural(len(pending), 'file')} renamed")
    else:
        report(f"done with {failures} error(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())