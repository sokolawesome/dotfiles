#!/usr/bin/env python3
"""Bulk rename tv show episodes and their dubs and subs to S01E01 format."""

import argparse
import re
from dataclasses import dataclass
from pathlib import Path

from rich_argparse import RichHelpFormatter

from _common import console, print_error, run_cli
from _prompts import ask_text
from _renaming import Rename, pad, rename_all

SEASON_WIDTH = 2
EPISODE_WIDTH = 2

VIDEO_SUFFIXES = (".mkv", ".mp4", ".avi")
AUDIO_SUFFIXES = (".mka", ".ac3", ".eac3", ".flac", ".aac")
SUBTITLE_SUFFIXES = (".ass", ".srt", ".vtt", ".sub")
TRACK_SUFFIXES = AUDIO_SUFFIXES + SUBTITLE_SUFFIXES
AUDIO = "audio"
SUBTITLES = "subtitles"
MEDIA_SUFFIXES = VIDEO_SUFFIXES + TRACK_SUFFIXES

LANGUAGE_CODES = (
    "en",
    "eng",
    "ru",
    "rus",
    "es",
    "spa",
    "ja",
    "jpn",
)

LANGUAGE_WORDS = {
    "ru": "rus",
    "rus": "rus",
    "russian": "rus",
    "рус": "rus",
    "русская": "rus",
    "русские": "rus",
    "русский": "rus",
    "en": "eng",
    "eng": "eng",
    "english": "eng",
    "англ": "eng",
    "английская": "eng",
    "английские": "eng",
    "английский": "eng",
    "es": "spa",
    "spa": "spa",
    "spanish": "spa",
    "ja": "jpn",
    "jp": "jpn",
    "jap": "jpn",
    "jpn": "jpn",
    "japanese": "jpn",
}
TRACK_FOLDER_WORDS = (
    "audio",
    "dub",
    "dubs",
    "sound",
    "sounds",
    "voice",
    "voices",
    "sub",
    "subs",
    "subtitles",
    "track",
    "tracks",
    "звук",
    "озвучка",
    "сабы",
    "субтитры",
)

QUALITY_WORDS = (
    "bdrip",
    "webrip",
    "web.dl",
    "bluray",
    "x264",
    "x265",
    "hevc",
    "avc",
    "flac",
    "aac",
    "ac3",
    "eac3",
    "dts",
    "opus",
    "10bit",
    "8bit",
)
RESOLUTION_WORDS = (r"[0-9]{3,4}p", r"[0-9]{4}x[0-9]{3,4}")
QUALITY_ALTERNATION = "|".join(QUALITY_WORDS + RESOLUTION_WORDS)

BRACKETED_TAG = re.compile(
    rf"\[([^\]]*(?:{QUALITY_ALTERNATION})[^\]]*)\]", re.IGNORECASE
)
PAREN_TAG = re.compile(rf"\(([^)]*(?:{QUALITY_ALTERNATION})[^)]*)\)", re.IGNORECASE)
BARE_TAG = re.compile(rf"\b(?:{QUALITY_ALTERNATION})\b", re.IGNORECASE)

DOTTED_SEASON_EPISODE = re.compile(r"S([0-9]{1,2})\.E([0-9]{1,3})", re.IGNORECASE)
JOINED_SEASON_EPISODE = re.compile(r"S([0-9]{1,2})E([0-9]{1,3})", re.IGNORECASE)
SEASON_EPISODE_X = re.compile(r"([0-9]{1,2})x([0-9]{1,3})")
BRACKETED_NUMBER = re.compile(r"\[([0-9]{1,3})\]")
DASHED_NUMBER = re.compile(r" - ([0-9]{1,3})[ .]")
TRAILING_NUMBER = re.compile(r"[ -]([0-9]{1,3})$")
LEADING_NUMBER = re.compile(r"^([0-9]{1,3})[\. ]")
MIDDLE_NUMBER = re.compile(r" ([0-9]{1,3}) ")

NAME_SEGMENT = re.compile(r"^[^\W\d_]+(?:[ '&-]+[^\W\d_]+)*$")
FOLDER_WORD = re.compile(r"[^\W_]+")

SEASON_IN_NAME = re.compile(
    r"season[\s._-]*([0-9]+)|(?<![a-z0-9])s([0-9]{1,2})(?![0-9])", re.IGNORECASE
)


@dataclass(frozen=True, order=True)
class TrackGroup:
    folder: Path
    kind: str


@dataclass(frozen=True)
class NumberPattern:
    season_group: int | None
    episode_group: int
    pattern: re.Pattern


LADDER = (
    NumberPattern(1, 2, JOINED_SEASON_EPISODE),
    NumberPattern(1, 2, SEASON_EPISODE_X),
    NumberPattern(None, 1, BRACKETED_NUMBER),
    NumberPattern(None, 1, DASHED_NUMBER),
    NumberPattern(None, 1, TRAILING_NUMBER),
    NumberPattern(None, 1, LEADING_NUMBER),
    NumberPattern(None, 1, MIDDLE_NUMBER),
)


def strip_extension(name: str) -> str:
    return re.sub(r"\.[^.]+$", "", name)


def normalize_dots(name: str) -> str:
    if " " in name:
        return name
    return name.replace(".", " ")


def normalize_underscores(name: str) -> str:
    return name.replace("_", " ")


def strip_quality_tags(name: str) -> str:
    without_brackets = BRACKETED_TAG.sub("", name)
    without_parens = PAREN_TAG.sub("", without_brackets)
    return BARE_TAG.sub("", without_parens).strip()


def normalize_name(name: str) -> str:
    without_extension = strip_extension(name)
    dotted = normalize_dots(without_extension)
    underscored = normalize_underscores(dotted)
    return strip_quality_tags(underscored)


def match_number(name: str) -> tuple[str | None, str] | None:
    dotted = DOTTED_SEASON_EPISODE.search(name)
    if dotted:
        return pad(dotted.group(1), SEASON_WIDTH), pad(dotted.group(2), EPISODE_WIDTH)

    normalized = normalize_name(name)
    for rung in LADDER:
        match = rung.pattern.search(normalized)
        if match:
            season = (
                None
                if rung.season_group is None
                else pad(match.group(rung.season_group), SEASON_WIDTH)
            )
            return season, pad(match.group(rung.episode_group), EPISODE_WIDTH)
    return None


def trailing_tags(stem: str) -> str:
    segments = stem.split(".")
    language = None
    for index in range(1, len(segments)):
        if segments[index].lower() in LANGUAGE_CODES:
            language = index
    if language is None:
        return ""
    last = language
    while last + 1 < len(segments) and NAME_SEGMENT.match(segments[last + 1]):
        last += 1
    tags = [
        segment.lower() if index == language else segment
        for index, segment in enumerate(segments[language : last + 1], start=language)
    ]
    return "." + ".".join(tags)


def media_suffix(name: str) -> str:
    for suffix in MEDIA_SUFFIXES:
        if name.lower().endswith(suffix):
            return suffix
    return ""


def target_suffix(name: str) -> str:
    suffix = media_suffix(name)
    if not suffix:
        return ""
    return f"{trailing_tags(name[: -len(suffix)])}{suffix}"


def untagged_track(path: Path) -> bool:
    suffix = media_suffix(path.name)
    return suffix in TRACK_SUFFIXES and not trailing_tags(path.name[: -len(suffix)])


def language_problem(language: str) -> str | None:
    if language.lower() in LANGUAGE_CODES:
        return None
    return f"use one of {', '.join(LANGUAGE_CODES)}"


def name_problem(name: str) -> str | None:
    if all(NAME_SEGMENT.match(segment) for segment in name.split(".")):
        return None
    return "use letters, spaces and - ' & between dots"


def folder_words(folder: str) -> list[str]:
    return FOLDER_WORD.findall(folder)


def guess_language(folders: tuple[str, ...]) -> str:
    for folder in reversed(folders):
        for word in reversed(folder_words(folder)):
            if word.lower() in LANGUAGE_WORDS:
                return LANGUAGE_WORDS[word.lower()]
    return ""


def guess_name(folders: tuple[str, ...]) -> str:
    for folder in reversed(folders):
        words = [
            word
            for word in folder_words(folder)
            if word.lower() not in LANGUAGE_WORDS
            and word.lower() not in TRACK_FOLDER_WORDS
        ]
        if words:
            return " ".join(words)
    return ""


def detect_season(directory_name: str) -> str | None:
    match = SEASON_IN_NAME.search(directory_name)
    if not match:
        return None
    return pad(match.group(1) or match.group(2), SEASON_WIDTH)


def scan_media_files(directory: Path) -> list[Path]:
    candidates = [p for p in directory.iterdir() if p.is_file()]
    return sorted(p for p in candidates if p.name.lower().endswith(MEDIA_SUFFIXES))


def hidden(path: Path, directory: Path) -> bool:
    return any(part.startswith(".") for part in path.relative_to(directory).parts)


def scan_track_folders(directory: Path) -> list[Path]:
    return sorted(
        p
        for p in directory.glob("*/**/*")
        if p.is_file()
        and p.name.lower().endswith(TRACK_SUFFIXES)
        and not hidden(p, directory)
    )


def group_of(path: Path) -> TrackGroup:
    kind = AUDIO if media_suffix(path.name) in AUDIO_SUFFIXES else SUBTITLES
    return TrackGroup(path.parent, kind)


def groups_to_tag(paths: list[Path]) -> list[TrackGroup]:
    return sorted(
        {
            group_of(path)
            for path in paths
            if untagged_track(path) and match_number(path.name) is not None
        }
    )


def folder_label(folder: Path, directory: Path) -> str:
    if folder == directory:
        return directory.resolve().name
    return str(folder.relative_to(directory))


def ask_tags(group: TrackGroup, directory: Path) -> str:
    folders = group.folder.relative_to(directory).parts
    label = f"{group.kind} in {folder_label(group.folder, directory)}"
    language = ask_text(
        f"language for {label}",
        guess_language(folders),
        LANGUAGE_CODES,
        language_problem,
    ).lower()
    name = ask_text(
        f"name for {label}",
        guess_name(folders),
        check=name_problem,
        required=False,
    )
    return "".join(f".{tag}" for tag in (language, name) if tag)


def ask_all_tags(paths: list[Path], directory: Path) -> dict[TrackGroup, str]:
    return {group: ask_tags(group, directory) for group in groups_to_tag(paths)}


def suffix_for(path: Path, tags: dict[TrackGroup, str]) -> str:
    group = group_of(path)
    if group in tags and untagged_track(path):
        return f"{tags[group]}{media_suffix(path.name)}"
    return target_suffix(path.name)


def lacks_season(path: Path) -> bool:
    parsed = match_number(path.name)
    return parsed is not None and parsed[0] is None


def resolve_season(argument: int | None, directory: Path) -> str | None:
    if argument is not None:
        return pad(argument, SEASON_WIDTH)
    return detect_season(directory.resolve().name)


def classify(
    paths: list[Path],
    season: str | None,
    episode_offset: int,
    directory: Path,
    tags: dict[TrackGroup, str],
) -> tuple[list[Rename], list[Path]]:
    episodes = []
    skipped = []
    for path in paths:
        parsed = match_number(path.name)
        suffix = suffix_for(path, tags)
        if parsed is None or not suffix:
            skipped.append(path)
            continue
        found_season, found_number = parsed
        episode_season = found_season or season
        number = int(found_number) + episode_offset
        if episode_season is None or number < 1:
            skipped.append(path)
            continue
        episodes.append(
            Rename(
                path,
                f"S{episode_season}E{pad(number, EPISODE_WIDTH)}{suffix}",
                directory,
            )
        )
    return episodes, skipped


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rename_episodes",
        formatter_class=RichHelpFormatter,
        description="rename episode files to S01E01 format, "
        "dubs and subs to S01E01.lang.name.ext",
        epilog="pass a directory to scan it, defaults to the current one. "
        "dubs and subs in its subfolders move next to the episodes, "
        "the language and name are asked for tracks without them",
    )
    parser.add_argument(
        "directory", nargs="?", type=Path, default=Path("."), help="directory to scan"
    )
    parser.add_argument(
        "-s",
        "--season",
        type=int,
        help="season for files without one in their name, "
        "detected from the directory name if absent",
    )
    parser.add_argument(
        "-o",
        "--offset",
        type=int,
        default=0,
        help="add this to every episode number, negative to subtract",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    directory = args.directory

    if not directory.is_dir():
        print_error(f"{directory} is not a directory")
        return 1

    paths = scan_media_files(directory) + scan_track_folders(directory)
    if not paths:
        print_error("no media files found")
        return 1

    season = None
    if any(lacks_season(path) for path in paths):
        season = resolve_season(args.season, directory)
        if season is None:
            print_error("could not detect season from the directory name")
            console.print("[dim]       use -s/--season to specify[/]")
            return 1
        if args.season is None:
            console.print(
                f"[question]detected season {season}[/] from directory name\n"
            )

    tags = ask_all_tags(paths, directory)
    episodes, skipped = classify(paths, season, args.offset, directory, tags)
    if not episodes:
        print_error("could not extract episode numbers from any files")
        return 1

    return rename_all(directory, episodes, skipped)


if __name__ == "__main__":
    run_cli(main)
