#!/usr/bin/env python3
"""Bulk rename tv show episodes to S01E01 format."""

import argparse
import re
from dataclasses import dataclass
from pathlib import Path

from _common import QUESTION, console, print_error, run_cli
from _renaming import Rename, pad, rename_all

SEASON_WIDTH = 2
EPISODE_WIDTH = 2

VIDEO_SUFFIXES = (".mkv", ".mp4", ".avi")
AUDIO_SUFFIXES = (".mka", ".ac3", ".eac3", ".flac", ".aac")
SUBTITLE_SUFFIXES = (".ass", ".srt", ".vtt", ".sub")
MEDIA_SUFFIXES = VIDEO_SUFFIXES + AUDIO_SUFFIXES + SUBTITLE_SUFFIXES

LANGUAGE_CODES = (
    "en",
    "eng",
    "ru",
    "rus",
    "es",
    "spa",
    "ja",
    "jpn",
)

QUALITY_WORDS = (
    "bdrip",
    "webrip",
    "web.dl",
    "bluray",
    "x264",
    "x265",
    "hevc",
    "avc",
    "flac",
    "aac",
    "ac3",
    "eac3",
    "dts",
    "opus",
    "10bit",
    "8bit",
)
RESOLUTION_WORDS = (r"[0-9]{3,4}p", r"[0-9]{4}x[0-9]{3,4}")
QUALITY_ALTERNATION = "|".join(QUALITY_WORDS + RESOLUTION_WORDS)

BRACKETED_TAG = re.compile(
    rf"\[([^\]]*(?:{QUALITY_ALTERNATION})[^\]]*)\]", re.IGNORECASE
)
PAREN_TAG = re.compile(rf"\(([^)]*(?:{QUALITY_ALTERNATION})[^)]*)\)", re.IGNORECASE)
BARE_TAG = re.compile(rf"\b(?:{QUALITY_ALTERNATION})\b", re.IGNORECASE)

DOTTED_SEASON_EPISODE = re.compile(r"S([0-9]{1,2})\.E([0-9]{1,3})", re.IGNORECASE)
JOINED_SEASON_EPISODE = re.compile(r"S([0-9]{1,2})E([0-9]{1,3})", re.IGNORECASE)
SEASON_EPISODE_X = re.compile(r"([0-9]{1,2})x([0-9]{1,3})")
BRACKETED_NUMBER = re.compile(r"\[([0-9]{1,3})\]")
DASHED_NUMBER = re.compile(r" - ([0-9]{1,3})[ .]")
TRAILING_NUMBER = re.compile(r"[ -]([0-9]{1,3})$")
LEADING_NUMBER = re.compile(r"^([0-9]{1,3})[\. ]")
MIDDLE_NUMBER = re.compile(r" ([0-9]{1,3}) ")

ALPHA_SEGMENT = re.compile(r"^[A-Za-z]+$")

SEASON_IN_NAME = re.compile(r"season[\s._-]*([0-9]+)", re.IGNORECASE)


@dataclass(frozen=True)
class NumberPattern:
    season_group: int | None
    episode_group: int
    pattern: re.Pattern


LADDER = (
    NumberPattern(1, 2, JOINED_SEASON_EPISODE),
    NumberPattern(1, 2, SEASON_EPISODE_X),
    NumberPattern(None, 1, BRACKETED_NUMBER),
    NumberPattern(None, 1, DASHED_NUMBER),
    NumberPattern(None, 1, TRAILING_NUMBER),
    NumberPattern(None, 1, LEADING_NUMBER),
    NumberPattern(None, 1, MIDDLE_NUMBER),
)


def strip_extension(name: str) -> str:
    return re.sub(r"\.[^.]+$", "", name)


def normalize_dots(name: str) -> str:
    if " " in name:
        return name
    return name.replace(".", " ")


def normalize_underscores(name: str) -> str:
    return name.replace("_", " ")


def strip_quality_tags(name: str) -> str:
    without_brackets = BRACKETED_TAG.sub("", name)
    without_parens = PAREN_TAG.sub("", without_brackets)
    return BARE_TAG.sub("", without_parens).strip()


def normalize_name(name: str) -> str:
    without_extension = strip_extension(name)
    dotted = normalize_dots(without_extension)
    underscored = normalize_underscores(dotted)
    return strip_quality_tags(underscored)


def match_number(name: str) -> tuple[str | None, str] | None:
    dotted = DOTTED_SEASON_EPISODE.search(name)
    if dotted:
        return pad(dotted.group(1), SEASON_WIDTH), pad(dotted.group(2), EPISODE_WIDTH)

    normalized = normalize_name(name)
    for rung in LADDER:
        match = rung.pattern.search(normalized)
        if match:
            season = (
                None
                if rung.season_group is None
                else pad(match.group(rung.season_group), SEASON_WIDTH)
            )
            return season, pad(match.group(rung.episode_group), EPISODE_WIDTH)
    return None


def trailing_tags(stem: str) -> str:
    segments = stem.split(".")
    language = None
    for index in range(1, len(segments)):
        if segments[index].lower() in LANGUAGE_CODES:
            language = index
    if language is None:
        return ""
    last = language
    while last + 1 < len(segments) and ALPHA_SEGMENT.match(segments[last + 1]):
        last += 1
    tags = [
        segment.lower() if index == language else segment
        for index, segment in enumerate(segments[language : last + 1], start=language)
    ]
    return "." + ".".join(tags)


def target_suffix(name: str) -> str:
    for suffix in MEDIA_SUFFIXES:
        if name.lower().endswith(suffix):
            return f"{trailing_tags(name[: -len(suffix)])}{suffix}"
    return ""


def detect_season(directory_name: str) -> str | None:
    match = SEASON_IN_NAME.search(directory_name)
    if not match:
        return None
    return pad(match.group(1), SEASON_WIDTH)


def scan_media_files(directory: Path) -> list[Path]:
    candidates = [p for p in directory.iterdir() if p.is_file()]
    return sorted(p for p in candidates if p.name.lower().endswith(MEDIA_SUFFIXES))


def resolve_season(argument: int | None, directory: Path) -> str | None:
    if argument is not None:
        return pad(argument, SEASON_WIDTH)
    return detect_season(directory.resolve().name)


def classify(
    paths: list[Path], season: str, episode_offset: int
) -> tuple[list[Rename], list[Path]]:
    episodes = []
    skipped = []
    for path in paths:
        parsed = match_number(path.name)
        suffix = target_suffix(path.name)
        if parsed is None or not suffix:
            skipped.append(path)
            continue
        found_season, found_number = parsed
        number = int(found_number) + episode_offset
        if number < 1:
            skipped.append(path)
            continue
        episodes.append(
            Rename(
                path, f"S{found_season or season}E{pad(number, EPISODE_WIDTH)}{suffix}"
            )
        )
    return episodes, skipped


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rename_episodes",
        description="rename episode files to S01E01 format",
        epilog="pass a directory to scan it, defaults to the current one",
    )
    parser.add_argument(
        "directory", nargs="?", type=Path, default=Path("."), help="directory to scan"
    )
    parser.add_argument(
        "-s",
        "--season",
        type=int,
        help="season number, detected from the directory name if absent",
    )
    parser.add_argument(
        "-o",
        "--offset",
        type=int,
        default=0,
        help="add this to every episode number, negative to subtract",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    directory = args.directory

    if not directory.is_dir():
        print_error(f"{directory} is not a directory")
        return 1

    season = resolve_season(args.season, directory)
    if season is None:
        print_error("could not detect season from the directory name")
        console.print("[dim]       use -s/--season to specify[/]")
        return 1
    if args.season is None:
        console.print(f"[{QUESTION}]detected season {season}[/] from directory name\n")

    paths = scan_media_files(directory)
    if not paths:
        print_error(f"no media files found in {directory}")
        return 1

    episodes, skipped = classify(paths, season, args.offset)
    if not episodes:
        print_error("could not extract episode numbers from any files")
        return 1

    return rename_all(directory, episodes, skipped)


if __name__ == "__main__":
    run_cli(main)
