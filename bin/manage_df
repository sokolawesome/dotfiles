#!/usr/bin/env python3
"""Stow, unstow or restow the dotfiles packages with gnu stow."""

import argparse
import os
import shutil
import subprocess
from dataclasses import dataclass
from pathlib import Path

from rich.console import Console
from rich.markup import escape
from rich.panel import Panel
from rich.table import Table

console = Console()

STOWED = "bold green"
VERBOSE = "yellow"
FAILED = "red"
PACKAGE = "bold cyan"

PACKAGES = {
    "home": Path.home(),
    "config": Path.home() / ".config",
    "bin": Path.home() / "bin",
    "agents": Path.home() / ".agents",
}
PACKAGE_ORDER = ("home", "config", "bin", "agents")

STOW_FLAGS = ("--no-folding",)


class ManageError(Exception):
    pass


@dataclass(frozen=True)
class Action:
    flag: str
    verb: str


ACTIONS = {
    "stow": Action("", "stowing"),
    "restow": Action("-R", "restowing"),
    "unstow": Action("-D", "unstowing"),
    "dry-run": Action("-n", "dry-run"),
}


@dataclass(frozen=True)
class Result:
    package: str
    target: Path
    outcome: str
    detail: str = ""


def stow_command(action: Action, target: Path, package: str, verbose: bool) -> list[str]:
    command = ["stow", *STOW_FLAGS]
    if action.flag:
        command.append(action.flag)
    if verbose:
        command.append("-v")
    command += ["-t", str(target), package]
    return command


def find_stow() -> str:
    found = shutil.which("stow")
    if found is None:
        raise ManageError("gnu stow not found, install with 'sudo pacman -S stow'")
    return found


def ensure_target(target: Path) -> None:
    target.mkdir(parents=True, exist_ok=True)


def selected_packages(requested: list[str]) -> list[str]:
    if not requested:
        return list(PACKAGE_ORDER)
    unknown = [name for name in requested if name not in PACKAGES]
    if unknown:
        known = ", ".join(PACKAGE_ORDER)
        raise ManageError(f"unknown package(s): {', '.join(unknown)}. known: {known}")
    return [name for name in PACKAGE_ORDER if name in requested]


def run_package(package: str, action: Action, verbose: bool) -> Result:
    target = PACKAGES[package]
    source_exists = (Path(os.environ.get("DOTFILES_PATH", ".")) / package).is_dir()
    if not source_exists:
        return Result(package, target, "missing")

    ensure_target(target)
    command = stow_command(action, target, package, verbose)
    finished = subprocess.run(command, capture_output=True, text=True, check=False)
    if finished.returncode != 0:
        return Result(package, target, "failed", finished.stderr.strip() or finished.stdout.strip())
    detail = finished.stdout.strip() if verbose else ""
    return Result(package, target, "done", detail)


def build_table(results: list[Result]) -> Table:
    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(width=8)
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="fold")
    styles = {
        "done": STOWED,
        "failed": FAILED,
        "missing": VERBOSE,
    }
    for result in results:
        style = styles[result.outcome]
        table.add_row(
            f"[{PACKAGE}]{result.package}[/]",
            f"[{style}]{result.outcome}[/]",
            f"[dim]{escape(str(result.target))}[/]",
        )
    return table


def build_detail(results: list[Result]) -> Table:
    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(overflow="fold")
    for result in results:
        if result.detail:
            for line in result.detail.splitlines():
                table.add_row(f"[dim]{escape(line)}[/]")
    return table


def report(action: Action, results: list[Result], verbose: bool) -> int:
    console.print(Panel(build_table(results), title=action.verb, border_style="cyan", padding=(0, 1)))
    if verbose:
        console.print(Panel(build_detail(results), title="stow output", border_style=VERBOSE, padding=(0, 1)))

    failures = [r for r in results if r.outcome == "failed"]
    if failures:
        names = ", ".join(r.package for r in failures)
        console.print(f"\n[red]failed:[/] {escape(names)}")
        return 1
    return 0


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    action = ACTIONS[args.action]

    try:
        find_stow()
        packages = selected_packages(args.package)
    except ManageError as error:
        console.print(f"[red]error:[/] {escape(str(error))}")
        return 1

    results = [run_package(package, action, args.verbose) for package in packages]
    return report(action, results, args.verbose)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="manage_df",
        description="stow the dotfiles packages with gnu stow",
        epilog=f"packages: {', '.join(PACKAGE_ORDER)}",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("-R", "--restow", action="store_const", const="restow", dest="action", help="remove then stow")
    mode.add_argument("-D", "--delete", action="store_const", const="unstow", dest="action", help="remove the symlinks")
    mode.add_argument("-n", "--dry-run", action="store_const", const="dry-run", dest="action", help="show what would happen")
    parser.set_defaults(action="stow")
    parser.add_argument("-p", "--package", action="append", metavar="NAME", help="limit to one package, repeatable")
    parser.add_argument("-v", "--verbose", action="store_true", help="show stow's own output")
    return parser


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        console.print("\n[yellow]cancelled[/]")
        raise SystemExit(130)