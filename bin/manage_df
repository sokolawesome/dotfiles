#!/usr/bin/env python3
"""Stow, unstow or restow the dotfiles packages with gnu stow."""

import argparse
import os
import shutil
import subprocess
from dataclasses import dataclass
from pathlib import Path

from rich.markup import escape
from rich.table import Table
from rich_argparse import RichHelpFormatter

from _common import (
    console,
    plain_table,
    print_error,
    run_cli,
    show_panel,
)
from _prompts import Option, choose_many

PACKAGES = {
    "home": Path.home(),
    "config": Path.home() / ".config",
    "bin": Path.home() / "bin",
    "agents": Path.home() / ".agents",
    "claude": Path.home() / ".claude",
}

STOW_FLAGS = ("--no-folding",)
SIMULATION_NOTICE = "WARNING: in simulation mode"


class ManageError(Exception):
    pass


@dataclass(frozen=True)
class Action:
    flag: str
    verb: str

    @property
    def simulated(self) -> bool:
        return self.flag == "-n"

    @property
    def links(self) -> bool:
        return self.flag in ("", "-R")


ACTIONS = {
    "stow": Action("", "stowing"),
    "restow": Action("-R", "restowing"),
    "unstow": Action("-D", "unstowing"),
    "dry-run": Action("-n", "dry-run"),
}


@dataclass(frozen=True)
class Result:
    package: str
    target: Path
    outcome: str
    detail: str = ""


def stow_command(
    action: Action, source: Path, target: Path, package: str, verbose: bool
) -> list[str]:
    command = ["stow", *STOW_FLAGS]
    if action.flag:
        command.append(action.flag)
    if verbose:
        command.append("-v")
    command += ["--dir", str(source), "-t", str(target), package]
    return command


def require_stow() -> None:
    if shutil.which("stow") is None:
        raise ManageError("gnu stow not found, install with 'sudo pacman -S stow'")


def stow_output(finished: subprocess.CompletedProcess) -> str:
    lines = f"{finished.stdout}\n{finished.stderr}".splitlines()
    return "\n".join(
        line
        for line in lines
        if line.strip() and not line.startswith(SIMULATION_NOTICE)
    )


def run_package(source: Path, package: str, action: Action, verbose: bool) -> Result:
    target = PACKAGES[package]
    if not (source / package).is_dir():
        return Result(package, target, "missing")

    if not target.is_dir():
        if action.links:
            target.mkdir(parents=True)
        elif action.simulated:
            return Result(package, target, "done", f"MKDIR: {target}, then link everything in {package}")
        else:
            return Result(package, target, "done")
    command = stow_command(action, source, target, package, verbose)
    finished = subprocess.run(command, capture_output=True, text=True, check=False)
    output = stow_output(finished)
    if finished.returncode != 0:
        return Result(package, target, "failed", output)
    return Result(package, target, "done", output if verbose else "")


def build_table(results: list[Result]) -> Table:
    table = plain_table()
    table.add_column(width=8)
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="fold")
    styles = {
        "done": "success",
        "failed": "failure",
        "missing": "warning",
    }
    for result in results:
        table.add_row(
            f"[name]{result.package}[/]",
            f"[{styles[result.outcome]}]{result.outcome}[/]",
            f"[dim]{escape(str(result.target))}[/]",
        )
    return table


def build_detail(results: list[Result]) -> Table:
    table = plain_table()
    table.add_column(width=8)
    table.add_column(overflow="fold")
    for result in results:
        for line in result.detail.splitlines():
            table.add_row(f"[name]{result.package}[/]", f"[dim]{escape(line)}[/]")
    return table


def report(action: Action, results: list[Result], verbose: bool) -> int:
    show_panel(build_table(results), action.verb)
    failures = [result for result in results if result.outcome == "failed"]
    succeeded = [result for result in results if result.outcome == "done"]
    if verbose:
        if any(result.detail for result in succeeded):
            show_panel(build_detail(succeeded), "stow output", "warning")
        else:
            console.print("[dim]stow made no changes[/]")

    if failures:
        show_panel(build_detail(failures), "errors", "failure")
        return 1
    return 0


def pick_packages() -> list[str]:
    packages = list(PACKAGES)
    options = [
        Option(package, (package,), str(PACKAGES[package])) for package in packages
    ]
    return choose_many("which packages", options, packages, required=True)


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    action = ACTIONS[args.action]
    verbose = args.verbose or action.simulated

    try:
        require_stow()
    except ManageError as error:
        print_error(str(error))
        return 1

    source = args.dotfiles
    if not source.is_dir():
        print_error(f"not a directory: {source}")
        return 1

    packages = pick_packages() if args.pick else list(PACKAGES)

    results = [run_package(source, package, action, verbose) for package in packages]
    return report(action, results, verbose)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="manage_df",
        formatter_class=RichHelpFormatter,
        description="stow the dotfiles packages with gnu stow",
        epilog=f"packages: {', '.join(PACKAGES)}",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "-R",
        "--restow",
        action="store_const",
        const="restow",
        dest="action",
        help="remove then stow",
    )
    mode.add_argument(
        "-D",
        "--delete",
        action="store_const",
        const="unstow",
        dest="action",
        help="remove the symlinks",
    )
    mode.add_argument(
        "-d",
        "--dry-run",
        action="store_const",
        const="dry-run",
        dest="action",
        help="show what stow would change",
    )
    parser.set_defaults(action="stow")
    parser.add_argument(
        "-i", "--pick", action="store_true", help="pick the packages from a list"
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="show stow's own output"
    )
    parser.add_argument(
        "--dotfiles",
        type=Path,
        default=Path(
            os.environ.get("DOTFILES_PATH", Path(__file__).resolve().parents[1])
        ),
        help="dotfiles repo root, defaults to DOTFILES_PATH or the parent of this script",
    )
    return parser


if __name__ == "__main__":
    run_cli(main)
