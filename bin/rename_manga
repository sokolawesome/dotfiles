#!/usr/bin/env python3
"""Bulk rename manga volumes and chapters to 01.cbz / c001.cbz."""

import argparse
import re
from pathlib import Path

from rich_argparse import RichHelpFormatter

from _common import print_error, run_cli
from _renaming import Rename, pad, rename_all

VOLUME = "v"
CHAPTER = "c"
KIND_ORDER = {VOLUME: 0, CHAPTER: 1}

VOLUME_WIDTH = 2
CHAPTER_WIDTH = 3

ARCHIVE_SUFFIXES = (".cbz", ".cbr")

ALREADY_VOLUME = re.compile(r"^(\d{1,3})$")
ALREADY_CHAPTER = re.compile(r"^c(\d{1,4})$", re.IGNORECASE)

LADDER = (
    (
        VOLUME,
        VOLUME_WIDTH,
        re.compile(r"\bv(?:ol(?:ume)?)?\.?\s*([0-9]+)", re.IGNORECASE),
    ),
    (
        CHAPTER,
        CHAPTER_WIDTH,
        re.compile(r"\bc(?:h(?:apter)?)?\.?\s*([0-9]+)", re.IGNORECASE),
    ),
    (CHAPTER, CHAPTER_WIDTH, re.compile(r"\b(?!(?:19|20)[0-9]{2}\b)([0-9]{1,4})\b")),
)


def strip_archive_suffix(name: str) -> str:
    return re.sub(r"\.[^.]+$", "", name)


def archive_suffix(name: str) -> str | None:
    for suffix in ARCHIVE_SUFFIXES:
        if name.lower().endswith(suffix):
            return suffix
    return None


def parse_kind_and_number(name: str) -> tuple[str, str] | None:
    stem = strip_archive_suffix(name)

    chapter = ALREADY_CHAPTER.match(stem)
    if chapter:
        return CHAPTER, pad(chapter.group(1), CHAPTER_WIDTH)

    volume = ALREADY_VOLUME.match(stem)
    if volume:
        return VOLUME, pad(volume.group(1), VOLUME_WIDTH)

    for kind, width, pattern in LADDER:
        match = pattern.search(stem)
        if match:
            return kind, pad(match.group(1), width)
    return None


def target_name(kind: str, number: str, suffix: str) -> str:
    if kind == VOLUME:
        return f"{number}{suffix}"
    return f"{kind}{number}{suffix}"


def scan_manga_files(directory: Path) -> list[Path]:
    return sorted(
        path
        for path in directory.iterdir()
        if path.is_file() and archive_suffix(path.name)
    )


def classify(paths: list[Path]) -> tuple[list[Rename], list[Path]]:
    ranked = []
    skipped = []
    for path in paths:
        parsed = parse_kind_and_number(path.name)
        suffix = archive_suffix(path.name)
        if parsed is None or suffix is None:
            skipped.append(path)
            continue
        kind, number = parsed
        rank = (KIND_ORDER[kind], int(number), path.name)
        ranked.append((rank, Rename(path, target_name(kind, number, suffix))))
    ranked.sort(key=lambda pair: pair[0])
    return [rename for _, rename in ranked], skipped


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rename_manga",
        formatter_class=RichHelpFormatter,
        description="rename manga files to a clean format",
        epilog="volumes become 01.cbz, chapters become c001.cbz; pass a directory to scan it, defaults to the current one",
    )
    parser.add_argument(
        "directory", nargs="?", type=Path, default=Path("."), help="directory to scan"
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    directory = args.directory

    if not directory.is_dir():
        print_error(f"{directory} is not a directory")
        return 1

    paths = scan_manga_files(directory)
    if not paths:
        print_error("no manga files found")
        return 1

    entries, skipped = classify(paths)
    if not entries:
        print_error("could not extract numbers from any files")
        return 1

    return rename_all(directory, entries, skipped)


if __name__ == "__main__":
    run_cli(main)
