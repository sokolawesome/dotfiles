#!/usr/bin/env python3
"""Strip audio and subtitle tracks from MKV files."""

import argparse
import re
import json
import os
import shutil
import subprocess
from dataclasses import dataclass
from pathlib import Path

from rich.console import Console
from rich.markup import escape
from rich.panel import Panel
from rich.progress import BarColumn, Progress, TextColumn, TimeElapsedColumn
from rich.prompt import Confirm, Prompt
from rich.table import Table

console = Console()

QUESTION = "bold cyan"
KEEP = "bold green"
FAIL = "red"
DIM = "dim"

MKV_SUFFIX = ".mkv"
TEMP_SUFFIX = ".stripping"
PROGRESS_LINE = re.compile(r"Progress:\s*(\d+)%")
AUDIO = "audio"
SUBTITLES = "subtitles"
SELECTABLE_TYPES = (AUDIO, SUBTITLES)
MKVMERGE_FLAGS = {AUDIO: "--audio-tracks", SUBTITLES: "--subtitle-tracks"}
SUPPORTED_SUBTITLE_LANGUAGES = (
    "en", "eng",
    "ja", "jpn",
    "ru", "rus",
    "es", "spa",
)


class StripError(Exception):
    pass


@dataclass(frozen=True)
class Track:
    kind: str
    track_id: int
    language: str
    alias: str
    name: str
    codec: str

    @property
    def label(self) -> str:
        return self.name or "unnamed"

    def speaks(self, wanted: str) -> bool:
        return wanted in (self.language.lower(), self.alias.lower())


@dataclass(frozen=True)
class FileScan:
    path: Path
    tracks: tuple[Track, ...]
    error: str = ""

    def readable(self) -> bool:
        return not self.error


@dataclass(frozen=True)
class Selection:
    kind: str
    language: str


@dataclass(frozen=True)
class FilePlan:
    path: Path
    keep: tuple[Track, ...]
    missing: tuple[Selection, ...]

    def ids_for(self, kind: str) -> list[int]:
        return [track.track_id for track in self.keep if track.kind == kind]

    def holds(self, kind: str) -> bool:
        return any(track.kind == kind for track in self.keep)


def find_mkvmerge() -> str:
    found = shutil.which("mkvmerge")
    if found is None:
        raise StripError("mkvmerge not found, install with 'sudo pacman -S mkvtoolnix-cli'")
    return found


def language_of(properties: dict) -> tuple[str, str]:
    ietf = (properties.get("language_ietf") or "").strip()
    full = (properties.get("language") or "").strip()
    if not ietf and not full:
        return ("und", "und")
    if not full:
        full = ietf
    if not ietf:
        ietf = full
    return (full.lower(), ietf.lower())


def parse_tracks(payload: str) -> tuple[Track, ...]:
    document = json.loads(payload)
    tracks = []
    for entry in document.get("tracks", []):
        properties = entry.get("properties", {})
        language, alias = language_of(properties)
        tracks.append(
            Track(
                kind=entry.get("type", ""),
                track_id=int(entry.get("id", -1)),
                language=language,
                alias=alias,
                name=(properties.get("track_name") or "").replace("|", "/"),
                codec=properties.get("codec_id", ""),
            )
        )
    return tuple(tracks)


def probe(path: Path, mkvmerge: str) -> FileScan:
    finished = subprocess.run([mkvmerge, "-J", str(path)], capture_output=True, text=True, check=False)
    if finished.returncode != 0:
        detail = finished.stderr.strip().splitlines()
        return FileScan(path, (), detail[0] if detail else "could not read tracks")
    try:
        return FileScan(path, parse_tracks(finished.stdout))
    except (json.JSONDecodeError, TypeError, ValueError) as error:
        return FileScan(path, (), f"unreadable track list: {error}")


def scan_files(directory: Path) -> list[Path]:
    if not directory.is_dir():
        raise StripError(f"not a directory: {directory}")
    return [p for p in sorted(directory.iterdir()) if p.is_file() and p.suffix == MKV_SUFFIX]


def collect(paths: list[Path], mkvmerge: str) -> list[FileScan]:
    return [probe(path, mkvmerge) for path in paths]


def supported_subtitle(track: Track) -> bool:
    return (
        track.language.lower() in SUPPORTED_SUBTITLE_LANGUAGES
        or track.alias.lower() in SUPPORTED_SUBTITLE_LANGUAGES
    )


def selectable(track: Track) -> bool:
    if track.kind == AUDIO:
        return True
    return track.kind == SUBTITLES and supported_subtitle(track)


def union_of(scans: list[FileScan]) -> list[Selection]:
    keys: dict[tuple[str, str], None] = {}
    for scan in scans:
        for track in scan.tracks:
            if selectable(track):
                keys.setdefault((track.kind, track.language), None)
    return [Selection(*key) for key in keys]


def matches_for(selection: Selection, scan: FileScan) -> list[Track]:
    return [track for track in scan.tracks if track.kind == selection.kind and track.speaks(selection.language)]


def presence_of(selection: Selection, scans: list[FileScan]) -> int:
    return sum(1 for scan in scans if matches_for(selection, scan))


def labels_for(selection: Selection, scans: list[FileScan]) -> list[str]:
    labels = []
    for scan in scans:
        for track in matches_for(selection, scan):
            if track.label not in labels:
                labels.append(track.label)
    return labels


def choose_interactively(scans: list[FileScan], union: list[Selection]) -> list[Selection]:
    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(justify="right", width=4)
    table.add_column(width=10)
    table.add_column(width=10)
    table.add_column(overflow="ellipsis")
    table.add_column(justify="right", width=8)
    for number, selection in enumerate(union, start=1):
        table.add_row(
            str(number),
            f"[{KEEP}]{escape(selection.kind)}[/]",
            escape(selection.language),
            escape(", ".join(labels_for(selection, scans)) or "unnamed"),
            f"[{DIM}]{presence_of(selection, scans)} files[/]",
        )
    console.print(Panel(table, title="tracks across all files", border_style="cyan", padding=(0, 1)))

    highest = len(union)
    while True:
        answer = Prompt.ask(
            f"[{QUESTION}]keep which[/] [dim](numbers, 'all', 'none')[/]"
        ).strip()
        if answer.lower() == "all":
            return list(union)
        if answer.lower() in ("none", ""):
            return []
        parts = answer.replace(",", " ").split()
        if not all(part.isdigit() and 1 <= int(part) <= highest for part in parts):
            console.print(f"[{FAIL}]pick numbers between 1 and {highest}[/]")
            continue
        return [union[int(part) - 1] for part in parts]


def resolve_picks(
    selections: list[Selection],
    scan: FileScan,
    ask: bool,
) -> list[Track]:
    chosen = []
    for selection in selections:
        candidates = matches_for(selection, scan)
        if not candidates:
            if ask:
                chosen.extend(pick_from_available(selection, scan))
            continue
        if len(candidates) > 1 and ask:
            chosen.extend(pick_from_candidates(selection, scan, candidates))
        else:
            chosen.extend(candidates)
    unique = []
    seen = set()
    for track in chosen:
        if track.track_id not in seen:
            seen.add(track.track_id)
            unique.append(track)
    return unique


def pick_from_candidates(selection: Selection, scan: FileScan, candidates: list[Track]) -> list[Track]:
    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(justify="right", width=4)
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="ellipsis")
    for number, track in enumerate(candidates, start=1):
        table.add_row(str(number), escape(track.label), f"[{DIM}]{escape(track.codec)}[/]")
    console.print(
        Panel(
            table,
            title=f"{scan.path.name}: {len(candidates)} {selection.kind} tracks in {selection.language}",
            border_style=FAIL,
            padding=(0, 1),
        )
    )
    while True:
        answer = Prompt.ask(f"[{QUESTION}]keep which[/] [dim](numbers, 'all')[/]").strip().lower()
        if answer in ("", "all"):
            return list(candidates)
        parts = answer.replace(",", " ").split()
        if all(part.isdigit() and 1 <= int(part) <= len(candidates) for part in parts):
            return [candidates[int(part) - 1] for part in parts]
        console.print(f"[{FAIL}]pick numbers between 1 and {len(candidates)}, or 'all'[/]")


def pick_from_available(selection: Selection, scan: FileScan) -> list[Track]:
    available = [track for track in scan.tracks if track.kind == selection.kind]
    if not available:
        return []
    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(justify="right", width=4)
    table.add_column(width=10)
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="ellipsis")
    for number, track in enumerate(available, start=1):
        table.add_row(
            str(number),
            escape(track.language),
            escape(track.label),
            f"[{DIM}]{escape(track.codec)}[/]",
        )
    console.print(
        Panel(
            table,
            title=f"{scan.path.name}: no {selection.language} {selection.kind}, pick a replacement",
            border_style=FAIL,
            padding=(0, 1),
        )
    )
    while True:
        answer = Prompt.ask(f"[{QUESTION}]keep which[/] [dim](numbers, 'none')[/]").strip().lower()
        if answer in ("", "none"):
            return []
        parts = answer.replace(",", " ").split()
        if all(part.isdigit() and 1 <= int(part) <= len(available) for part in parts):
            return [available[int(part) - 1] for part in parts]
        console.print(f"[{FAIL}]pick numbers between 1 and {len(available)}, or 'none'[/]")


def build_plan(scans: list[FileScan], selections: list[Selection], ask: bool) -> list[FilePlan]:
    plans = []
    for scan in scans:
        keep = resolve_picks(selections, scan, ask)
        missing = tuple(s for s in selections if not matches_for(s, scan))
        plans.append(FilePlan(scan.path, tuple(keep), missing))
    return plans


def line_buffered(command: list[str]) -> list[str]:
    if shutil.which("stdbuf"):
        return ["stdbuf", "-oL", *command]
    return command


def strip_command(plan: FilePlan, mkvmerge: str) -> list[str]:
    temp = plan.path.with_name(plan.path.stem + TEMP_SUFFIX + MKV_SUFFIX)
    command = [mkvmerge, "-o", str(temp)]
    for kind in SELECTABLE_TYPES:
        ids = plan.ids_for(kind)
        if ids:
            command += [MKVMERGE_FLAGS[kind], ",".join(str(i) for i in ids)]
    command.append(str(plan.path))
    return command


def read_progress(stream, report) -> None:
    for line in stream:
        for chunk in line.replace("\r", "\n").split("\n"):
            match = PROGRESS_LINE.search(chunk)
            if match:
                report(int(match.group(1)))


def strip_one(plan: FilePlan, mkvmerge: str, report=None) -> tuple[bool, str]:
    temp = plan.path.with_name(plan.path.stem + TEMP_SUFFIX + MKV_SUFFIX)
    command = line_buffered(strip_command(plan, mkvmerge))
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
    except OSError as error:
        return False, str(error)
    with process:
        read_progress(process.stdout, report or (lambda percent: None))
        errors = process.stderr.read()
        code = process.wait()
    if code != 0:
        temp.unlink(missing_ok=True)
        detail = errors.strip().splitlines()
        return False, detail[0] if detail else f"mkvmerge exited {code}"
    if not temp.is_file():
        return False, "mkvmerge produced no output file"
    os.replace(temp, plan.path)
    return True, ""


def size_of(paths: list[Path]) -> int:
    total = 0
    for path in paths:
        try:
            total += path.stat().st_size
        except OSError:
            continue
    return total


def format_size(value: int) -> str:
    if value >= 1073741824:
        return f"{value / 1073741824:.2f} GiB"
    if value >= 1048576:
        return f"{value / 1048576:.2f} MiB"
    return f"{value} B"


def describe_missing(plan: FilePlan) -> str:
    parts = [f"{s.kind[:3]} {s.language}" for s in plan.missing]
    return ", ".join(parts)


def track_summary(tracks: list[Track]) -> str:
    return ", ".join(f"{track.language} {track.label}" for track in tracks) or "-"


def plan_signature(plan: FilePlan) -> tuple:
    kept = tuple((track.kind, track.language, track.name) for track in plan.keep)
    missing = tuple((selection.kind, selection.language) for selection in plan.missing)
    return kept, missing


def build_plan_table(plans: list[FilePlan]) -> Table:
    groups: dict[tuple, list[FilePlan]] = {}
    for plan in plans:
        groups.setdefault(plan_signature(plan), []).append(plan)

    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(overflow="ellipsis", ratio=1, min_width=24)
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="fold")
    for members in groups.values():
        first = members[0]
        heading = first.path.name if len(members) == 1 else f"{len(members)} files"
        audio = track_summary([track for track in first.keep if track.kind == AUDIO])
        subs = track_summary([track for track in first.keep if track.kind == SUBTITLES])
        if first.missing:
            note = f"[{DIM}]missing:[/] [dim]{escape(describe_missing(first))}[/]"
        else:
            note = f"[{DIM}]clean[/]"
        table.add_row(escape(heading), f"audio {escape(audio)}", f"subs {escape(subs)}", note)
    return table


def build_problem_table(scans: list[FileScan]) -> Table:
    table = Table(box=None, pad_edge=False, show_edge=False, show_header=False)
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="fold")
    for scan in scans:
        if scan.error:
            table.add_row(escape(scan.path.name), f"[{FAIL}]{escape(scan.error)}[/]")
    return table


def report_unreadable(scans: list[FileScan]) -> None:
    if any(not scan.readable() for scan in scans):
        console.print(Panel(build_problem_table(scans), title="unreadable", border_style=FAIL, padding=(0, 1)))


def strip_all(plans: list[FilePlan], mkvmerge: str) -> int:
    failures = 0
    with Progress(
        TextColumn("[progress.description]{task.description}"),
        BarColumn(complete_style=KEEP, style=DIM, finished_style=KEEP),
        TextColumn("[progress.percentage]{task.percentage:>3.0f}%"),
        TimeElapsedColumn(),
        console=console,
        transient=True,
    ) as progress:
        overall = None if len(plans) == 1 else progress.add_task("stripping", total=len(plans))
        for index, plan in enumerate(plans, start=1):
            if overall is not None:
                progress.update(overall, description=f"{index - 1}/{len(plans)}")
            task = progress.add_task(escape(plan.path.name), total=100)
            ok, detail = strip_one(plan, mkvmerge, lambda percent: progress.update(task, completed=percent))
            progress.remove_task(task)
            if not ok:
                failures += 1
                console.print(f"[{FAIL}]x[/] {escape(plan.path.name)}: {escape(detail)}")
            if overall is not None:
                progress.advance(overall)
    return failures


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="mkv_strip_tracks",
        description="strip audio and subtitle tracks from mkv files, matching by language",
        epilog="pass a directory to scan it, defaults to the current one",
    )
    parser.add_argument("directory", nargs="?", type=Path, default=Path("."), help="directory to scan")
    return parser


def run(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    try:
        mkvmerge = find_mkvmerge()
        paths = scan_files(args.directory)
    except StripError as error:
        console.print(f"[{FAIL}]error:[/] {escape(str(error))}")
        return 1

    if not paths:
        console.print(f"[{FAIL}]error:[/] no .mkv files in {escape(str(args.directory))}")
        return 1

    scans = collect(paths, mkvmerge)
    report_unreadable(scans)
    readable = [scan for scan in scans if scan.readable()]
    if not readable:
        return 1

    union = union_of(readable)
    if not union:
        console.print("[red]error:[/] no audio or supported subtitle tracks found")
        return 1

    selections = choose_interactively(readable, union)
    if not selections:
        console.print("[yellow]nothing selected[/]")
        return 0

    plans = build_plan(readable, selections, True)
    console.print(Panel(build_plan_table(plans), title="plan", border_style="cyan", padding=(0, 1)))

    if not Confirm.ask(f"[{QUESTION}]strip {len(plans)} file(s)?[/]", default=False, console=console):
        console.print("[yellow]cancelled[/]")
        return 1

    before = size_of([plan.path for plan in plans])
    failures = strip_all(plans, mkvmerge)
    after = size_of([plan.path for plan in plans])

    console.print()
    if failures:
        console.print(f"[{FAIL}]done with {failures} error(s)[/]")
    else:
        console.print(f"[{KEEP}]done - {len(plans)} files stripped[/]")
    console.print(f"[{QUESTION}]before:[/] {format_size(before)}")
    console.print(f"[{QUESTION}]after:  [/] {format_size(after)}")
    console.print(f"[{QUESTION}]saved:  [/] {format_size(before - after)}")
    return 1 if failures else 0


def main(argv: list[str] | None = None) -> int:
    try:
        return run(argv)
    except (KeyboardInterrupt, EOFError):
        console.print("\n[yellow]cancelled[/]")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())