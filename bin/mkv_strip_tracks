#!/usr/bin/env python3
"""Strip audio and subtitle tracks from MKV files."""

import argparse
import json
import os
import re
import shutil
import subprocess
from collections.abc import Callable, Iterable
from dataclasses import dataclass, field
from pathlib import Path

from rich.markup import escape
from rich.progress import BarColumn, Progress, TextColumn, TimeElapsedColumn
from rich.table import Table
from rich_argparse import RichHelpFormatter

from _common import (
    console,
    notify,
    plain_table,
    plural,
    print_cancelled,
    print_error,
    run_cli,
    show_panel,
)
from _prompts import Option, choose_many, confirm

MKV_SUFFIX = ".mkv"
TEMP_SUFFIX = ".stripping"
PROGRESS_LINE = re.compile(r"Progress:\s*(\d+)%")
AUDIO = "audio"
SUBTITLES = "subtitles"
SELECTABLE_TYPES = (AUDIO, SUBTITLES)
MKVMERGE_FLAGS = {AUDIO: "--audio-tracks", SUBTITLES: "--subtitle-tracks"}
MKVMERGE_DROP_FLAGS = {AUDIO: "--no-audio", SUBTITLES: "--no-subtitles"}
MKVMERGE_FAILED = 2
MEBIBYTE = 1024**2
GIBIBYTE = 1024**3
SUPPORTED_SUBTITLE_LANGUAGES = (
    "en",
    "eng",
    "ja",
    "jpn",
    "ru",
    "rus",
    "es",
    "spa",
)


class StripError(Exception):
    pass


@dataclass(frozen=True)
class StripResult:
    path: Path
    before: int
    after: int
    error: str = ""

    @property
    def saved(self) -> int:
        return self.before - self.after


@dataclass(frozen=True)
class Track:
    kind: str
    track_id: int
    language: str
    alias: str
    name: str
    codec: str

    @property
    def label(self) -> str:
        return self.name or "unnamed"

    def speaks(self, wanted: str) -> bool:
        return wanted in (self.language, self.alias)


@dataclass(frozen=True)
class FileScan:
    path: Path
    tracks: tuple[Track, ...]
    error: str = ""

    @property
    def readable(self) -> bool:
        return not self.error


@dataclass(frozen=True)
class Selection:
    kind: str
    language: str


@dataclass(frozen=True)
class FilePlan:
    path: Path
    keep: tuple[Track, ...]
    missing: tuple[Selection, ...]
    kinds: frozenset[str] = field(default_factory=frozenset)
    tracks: tuple[Track, ...] = ()

    def ids_for(self, kind: str) -> list[int]:
        return [track.track_id for track in self.keep if track.kind == kind]

    @property
    def temp_path(self) -> Path:
        return self.path.with_name(self.path.stem + TEMP_SUFFIX + MKV_SUFFIX)

    @property
    def changes_file(self) -> bool:
        return any(
            set(self.ids_for(kind))
            != {track.track_id for track in self.tracks if track.kind == kind}
            for kind in self.kinds
        )


def find_mkvmerge() -> str:
    found = shutil.which("mkvmerge")
    if found is None:
        raise StripError(
            "mkvmerge not found, install with 'sudo pacman -S mkvtoolnix-cli'"
        )
    return found


def language_of(properties: dict) -> tuple[str, str]:
    ietf = (properties.get("language_ietf") or "").strip()
    full = (properties.get("language") or "").strip()
    if not ietf and not full:
        return ("und", "und")
    if not full:
        full = ietf
    if not ietf:
        ietf = full
    return (full.lower(), ietf.lower())


def parse_tracks(payload: str) -> tuple[Track, ...]:
    document = json.loads(payload)
    errors = document.get("errors") or []
    if errors:
        raise ValueError(errors[0].strip())
    if not document.get("container", {}).get("recognized"):
        raise ValueError("not a recognized media file")
    tracks = []
    for entry in document.get("tracks", []):
        properties = entry.get("properties", {})
        language, alias = language_of(properties)
        tracks.append(
            Track(
                kind=entry.get("type", ""),
                track_id=int(entry.get("id", -1)),
                language=language,
                alias=alias,
                name=(properties.get("track_name") or "").replace("|", "/"),
                codec=properties.get("codec_id", ""),
            )
        )
    return tuple(tracks)


def probe(path: Path, mkvmerge: str) -> FileScan:
    finished = subprocess.run(
        [mkvmerge, "-J", str(path)], capture_output=True, text=True, check=False
    )
    try:
        return FileScan(path, parse_tracks(finished.stdout))
    except (json.JSONDecodeError, TypeError, ValueError) as error:
        return FileScan(path, (), str(error) or f"mkvmerge exited {finished.returncode}")


def scan_files(directory: Path) -> list[Path]:
    if not directory.is_dir():
        raise StripError(f"not a directory: {directory}")
    return [
        p
        for p in sorted(directory.iterdir())
        if p.is_file() and p.suffix.lower() == MKV_SUFFIX
    ]


def supported_subtitle(track: Track) -> bool:
    return (
        track.language in SUPPORTED_SUBTITLE_LANGUAGES
        or track.alias in SUPPORTED_SUBTITLE_LANGUAGES
    )


def selectable(track: Track) -> bool:
    if track.kind == AUDIO:
        return True
    return track.kind == SUBTITLES and supported_subtitle(track)


def union_of(scans: list[FileScan]) -> list[Selection]:
    keys: dict[tuple[str, str], None] = {}
    for scan in scans:
        for track in scan.tracks:
            if selectable(track):
                keys.setdefault((track.kind, track.language), None)
    return [Selection(*key) for key in keys]


def matches_for(selection: Selection, scan: FileScan) -> list[Track]:
    return [
        track
        for track in scan.tracks
        if track.kind == selection.kind and track.speaks(selection.language)
    ]


def presence_of(selection: Selection, scans: list[FileScan]) -> int:
    return sum(1 for scan in scans if matches_for(selection, scan))


def labels_for(selection: Selection, scans: list[FileScan]) -> list[str]:
    labels = []
    for scan in scans:
        for track in matches_for(selection, scan):
            if track.label not in labels:
                labels.append(track.label)
    return labels


def choose_interactively(
    scans: list[FileScan], union: list[Selection]
) -> list[Selection]:
    options = [
        Option(
            selection,
            (
                selection.kind,
                selection.language,
                ", ".join(labels_for(selection, scans)) or "unnamed",
            ),
            plural(presence_of(selection, scans), "file"),
        )
        for selection in union
    ]
    return choose_many("keep which tracks", options)


def resolve_picks(
    selections: list[Selection],
    scan: FileScan,
    ask: bool,
) -> list[Track]:
    chosen = []
    for selection in selections:
        candidates = matches_for(selection, scan)
        if not candidates:
            if ask:
                chosen.extend(pick_from_available(selection, scan))
            continue
        if len(candidates) > 1 and ask:
            chosen.extend(pick_from_candidates(selection, scan, candidates))
        else:
            chosen.extend(candidates)
    unique = []
    seen = set()
    for track in chosen:
        if track.track_id not in seen:
            seen.add(track.track_id)
            unique.append(track)
    return unique


def pick_from_candidates(
    selection: Selection, scan: FileScan, candidates: list[Track]
) -> list[Track]:
    options = [Option(track, (track.label,), track.codec) for track in candidates]
    return choose_many(
        f"{scan.path.name}: {len(candidates)} {selection.kind} tracks in {selection.language}",
        options,
        candidates,
        required=True,
        border="failure",
    )


def pick_from_available(selection: Selection, scan: FileScan) -> list[Track]:
    available = [track for track in scan.tracks if track.kind == selection.kind]
    if not available:
        return []
    options = [
        Option(track, (track.language, track.label), track.codec) for track in available
    ]
    return choose_many(
        f"{scan.path.name}: no {selection.language} {selection.kind}, pick a replacement",
        options,
        border="failure",
    )


def build_plan(
    scans: list[FileScan], selections: list[Selection], ask: bool
) -> list[FilePlan]:
    kinds = frozenset(selection.kind for selection in selections)
    plans = []
    for scan in scans:
        keep = resolve_picks(selections, scan, ask)
        missing = tuple(s for s in selections if not matches_for(s, scan))
        plans.append(FilePlan(scan.path, tuple(keep), missing, kinds, scan.tracks))
    return plans


def line_buffered(command: list[str]) -> list[str]:
    if shutil.which("stdbuf"):
        return ["stdbuf", "-oL", *command]
    return command


def strip_command(plan: FilePlan, mkvmerge: str) -> list[str]:
    command = [mkvmerge, "-o", str(plan.temp_path)]
    for kind in SELECTABLE_TYPES:
        ids = plan.ids_for(kind)
        if ids:
            command += [MKVMERGE_FLAGS[kind], ",".join(str(i) for i in ids)]
        elif kind in plan.kinds:
            command.append(MKVMERGE_DROP_FLAGS[kind])
    command.append(str(plan.path))
    return command


def read_progress(stream: Iterable[str], report: Callable[[int], object]) -> list[str]:
    messages = []
    for line in stream:
        for chunk in line.replace("\r", "\n").split("\n"):
            match = PROGRESS_LINE.search(chunk)
            if match:
                report(int(match.group(1)))
            elif chunk.strip():
                messages.append(chunk.strip())
    return messages


def failure_reason(messages: list[str], code: int) -> str:
    errors = [message for message in messages if message.startswith("Error")]
    if errors:
        return errors[0]
    if messages:
        return messages[-1]
    return f"mkvmerge exited {code}"


def strip_one(plan: FilePlan, mkvmerge: str, report: Callable[[int], object] | None = None) -> tuple[bool, str]:
    temp = plan.temp_path
    command = line_buffered(strip_command(plan, mkvmerge))
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
    except OSError as error:
        return False, str(error)
    with process:
        try:
            messages = read_progress(process.stdout or [], report or (lambda percent: None))
            code = process.wait()
        except BaseException:
            process.kill()
            process.wait()
            temp.unlink(missing_ok=True)
            raise
    if code >= MKVMERGE_FAILED:
        temp.unlink(missing_ok=True)
        return False, failure_reason(messages, code)
    if not temp.is_file():
        return False, "mkvmerge produced no output file"
    os.replace(temp, plan.path)
    return True, ""


def size_of(path: Path) -> int:
    try:
        return path.stat().st_size
    except OSError:
        return 0


def format_size(value: int) -> str:
    if value < 0:
        return f"-{format_size(-value)}"
    if value >= GIBIBYTE:
        return f"{value / GIBIBYTE:.2f} GiB"
    if value >= MEBIBYTE:
        return f"{value / MEBIBYTE:.2f} MiB"
    return f"{value} B"


def describe_missing(plan: FilePlan) -> str:
    parts = [f"{s.kind[:3]} {s.language}" for s in plan.missing]
    return ", ".join(parts)


def track_summary(tracks: list[Track]) -> str:
    return ", ".join(f"{track.language} {track.label}" for track in tracks) or "-"


def plan_signature(plan: FilePlan) -> tuple:
    kept = tuple((track.kind, track.language, track.name) for track in plan.keep)
    missing = tuple((selection.kind, selection.language) for selection in plan.missing)
    return kept, missing, plan.changes_file


def build_plan_table(plans: list[FilePlan]) -> Table:
    groups: dict[tuple, list[FilePlan]] = {}
    for plan in plans:
        groups.setdefault(plan_signature(plan), []).append(plan)

    table = plain_table()
    table.add_column(overflow="ellipsis", ratio=1, min_width=24)
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="fold")
    for members in groups.values():
        first = members[0]
        heading = first.path.name if len(members) == 1 else f"{len(members)} files"
        audio = track_summary([track for track in first.keep if track.kind == AUDIO])
        subs = track_summary([track for track in first.keep if track.kind == SUBTITLES])
        if first.kinds and not first.changes_file:
            note = "[dim]nothing to strip[/]"
        elif first.missing:
            note = f"[dim]missing: {escape(describe_missing(first))}[/]"
        else:
            note = "[dim]clean[/]"
        table.add_row(
            escape(heading), f"audio {escape(audio)}", f"subs {escape(subs)}", note
        )
    return table


def build_problem_table(scans: list[FileScan]) -> Table:
    table = plain_table()
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="fold")
    for scan in scans:
        if scan.error:
            table.add_row(escape(scan.path.name), f"[failure]{escape(scan.error)}[/]")
    return table


def report_unreadable(scans: list[FileScan]) -> None:
    if any(not scan.readable for scan in scans):
        show_panel(build_problem_table(scans), "unreadable", "failure")


def strip_all(plans: list[FilePlan], mkvmerge: str) -> list[StripResult]:
    results = []
    with Progress(
        TextColumn("[progress.description]{task.description}"),
        BarColumn(complete_style="success", style="dim", finished_style="success"),
        TextColumn("[progress.percentage]{task.percentage:>3.0f}%"),
        TimeElapsedColumn(),
        console=console,
        transient=True,
    ) as progress:
        overall = (
            None
            if len(plans) == 1
            else progress.add_task("stripping", total=len(plans))
        )
        for index, plan in enumerate(plans, start=1):
            if overall is not None:
                progress.update(overall, description=f"{index - 1}/{len(plans)}")
            task = progress.add_task(escape(plan.path.name), total=100)
            before = size_of(plan.path)
            ok, detail = strip_one(
                plan,
                mkvmerge,
                lambda percent, task=task: progress.update(task, completed=percent),
            )
            progress.remove_task(task)
            if not ok:
                console.print(
                    f"[failure]x[/] {escape(plan.path.name)}: {escape(detail)}"
                )
            results.append(
                StripResult(plan.path, before, size_of(plan.path) if ok else before, detail)
            )
            if overall is not None:
                progress.advance(overall)
    return results


def build_result_table(results: list[StripResult]) -> Table:
    table = Table(box=None, pad_edge=False, show_edge=False, header_style="dim")
    table.add_column("file", overflow="ellipsis", ratio=1)
    table.add_column("before", justify="right")
    table.add_column("after", justify="right")
    table.add_column("saved", justify="right", style="success")
    for result in results:
        if result.error:
            table.add_row(
                escape(result.path.name), format_size(result.before), "[failure]failed[/]", ""
            )
        else:
            table.add_row(
                escape(result.path.name),
                format_size(result.before),
                format_size(result.after),
                format_size(result.saved),
            )
    if len(results) > 1:
        table.add_section()
        table.add_row(
            "[bold]total[/]",
            format_size(sum(result.before for result in results)),
            format_size(sum(result.after for result in results)),
            format_size(sum(result.saved for result in results)),
        )
    return table


def probe_all(paths: list[Path], mkvmerge: str) -> list[FileScan]:
    scans = []
    with console.status("probing") as status:
        for index, path in enumerate(paths, start=1):
            status.update(f"probing {index}/{len(paths)} [dim]{escape(path.name)}[/]")
            scans.append(probe(path, mkvmerge))
    return scans


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="mkv_strip_tracks",
        formatter_class=RichHelpFormatter,
        description="strip audio and subtitle tracks from mkv files, matching by language",
        epilog="pass a directory to scan it, defaults to the current one",
    )
    parser.add_argument(
        "directory", nargs="?", type=Path, default=Path("."), help="directory to scan"
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    try:
        mkvmerge = find_mkvmerge()
        paths = scan_files(args.directory)
    except StripError as error:
        print_error(str(error))
        return 1

    if not paths:
        print_error("no .mkv files found")
        return 1

    scans = probe_all(paths, mkvmerge)
    report_unreadable(scans)
    readable = [scan for scan in scans if scan.readable]
    if not readable:
        return 1

    union = union_of(readable)
    if not union:
        print_error("no audio or supported subtitle tracks found")
        return 1

    selections = choose_interactively(readable, union)
    if not selections:
        console.print("[warning]nothing selected[/]")
        return 0

    plans = build_plan(readable, selections, True)
    show_panel(build_plan_table(plans), "plan")

    changing = [plan for plan in plans if plan.changes_file]
    if not changing:
        console.print(
            "[success]nothing to strip[/], every file already has only the picked tracks"
        )
        return 0

    if not confirm(f"strip {len(changing)} file(s)?"):
        print_cancelled()
        return 1

    results = strip_all(changing, mkvmerge)
    failures = sum(1 for result in results if result.error)
    saved = format_size(sum(result.saved for result in results))

    show_panel(build_result_table(results), "result")
    if failures:
        summary = f"done with {plural(failures, 'error')}"
        console.print(f"[failure]{summary}[/]")
    else:
        summary = f"done - {len(changing)} files stripped"
        console.print(f"[success]{summary}[/], saved {saved}")
    notify("mkv_strip_tracks", f"{summary}, saved {saved}")
    return 1 if failures else 0


if __name__ == "__main__":
    run_cli(main)
