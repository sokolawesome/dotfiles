#!/usr/bin/env python3
"""Strip audio and subtitle tracks from MKV files."""

import argparse
import os
from collections.abc import Callable
from dataclasses import dataclass, field
from pathlib import Path

from rich.markup import escape
from rich.table import Table
from rich_argparse import RichHelpFormatter

from _common import (
    console,
    notify,
    plain_table,
    plural,
    print_cancelled,
    print_error,
    run_cli,
    show_panel,
)
from _mkv import (
    AUDIO,
    MKV_SUFFIX,
    SELECTABLE_TYPES,
    SUBTITLES,
    FileScan,
    MkvError,
    Selection,
    Track,
    choose_interactively,
    describe_missing,
    find_tool,
    format_size,
    picked_for,
    probe_all,
    progress_bars,
    report_unreadable,
    resolve_picks,
    run_with_progress,
    scan_files,
    size_of,
    union_of,
)
from _prompts import confirm

TEMP_SUFFIX = ".stripping"
MKVMERGE_FLAGS = {AUDIO: "--audio-tracks", SUBTITLES: "--subtitle-tracks"}
MKVMERGE_DROP_FLAGS = {AUDIO: "--no-audio", SUBTITLES: "--no-subtitles"}


@dataclass(frozen=True)
class StripResult:
    path: Path
    before: int
    after: int
    error: str = ""

    @property
    def saved(self) -> int:
        return self.before - self.after


@dataclass(frozen=True)
class FilePlan:
    path: Path
    keep: tuple[Track, ...]
    missing: tuple[Selection, ...]
    kinds: frozenset[str] = field(default_factory=frozenset)
    tracks: tuple[Track, ...] = ()

    def ids_for(self, kind: str) -> list[int]:
        return [track.track_id for track in self.keep if track.kind == kind]

    @property
    def temp_path(self) -> Path:
        return self.path.with_name(self.path.stem + TEMP_SUFFIX + MKV_SUFFIX)

    @property
    def changes_file(self) -> bool:
        return any(
            set(self.ids_for(kind))
            != {track.track_id for track in self.tracks if track.kind == kind}
            for kind in self.kinds
        )


def build_plan(
    scans: list[FileScan], selections: list[Selection], ask: bool
) -> list[FilePlan]:
    kinds = frozenset(selection.kind for selection in selections)
    plans = []
    for scan in scans:
        keep = resolve_picks(selections, scan, ask)
        missing = tuple(s for s in selections if not picked_for(s, scan))
        plans.append(FilePlan(scan.path, tuple(keep), missing, kinds, scan.tracks))
    return plans


def strip_command(plan: FilePlan, mkvmerge: str) -> list[str]:
    command = [mkvmerge, "-o", str(plan.temp_path)]
    for kind in SELECTABLE_TYPES:
        ids = plan.ids_for(kind)
        if ids:
            command += [MKVMERGE_FLAGS[kind], ",".join(str(i) for i in ids)]
        elif kind in plan.kinds:
            command.append(MKVMERGE_DROP_FLAGS[kind])
    command.append(str(plan.path))
    return command


def strip_one(
    plan: FilePlan, mkvmerge: str, report: Callable[[int], object] | None = None
) -> tuple[bool, str]:
    temp = plan.temp_path
    try:
        failure = run_with_progress(strip_command(plan, mkvmerge), report)
    except OSError as error:
        return False, str(error)
    except BaseException:
        temp.unlink(missing_ok=True)
        raise
    if failure:
        temp.unlink(missing_ok=True)
        return False, failure
    if not temp.is_file():
        return False, "mkvmerge produced no output file"
    os.replace(temp, plan.path)
    return True, ""


def track_summary(tracks: list[Track]) -> str:
    return ", ".join(f"{track.language} {track.label}" for track in tracks) or "-"


def plan_signature(plan: FilePlan) -> tuple:
    kept = tuple((track.kind, track.language, track.name) for track in plan.keep)
    missing = tuple((selection.kind, selection.language) for selection in plan.missing)
    return kept, missing, plan.changes_file


def build_plan_table(plans: list[FilePlan]) -> Table:
    groups: dict[tuple, list[FilePlan]] = {}
    for plan in plans:
        groups.setdefault(plan_signature(plan), []).append(plan)

    table = plain_table()
    table.add_column(overflow="ellipsis", ratio=1, min_width=24)
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="ellipsis")
    table.add_column(overflow="fold")
    for members in groups.values():
        first = members[0]
        heading = first.path.name if len(members) == 1 else f"{len(members)} files"
        audio = track_summary([track for track in first.keep if track.kind == AUDIO])
        subs = track_summary([track for track in first.keep if track.kind == SUBTITLES])
        if first.kinds and not first.changes_file:
            note = "[dim]nothing to strip[/]"
        elif first.missing:
            note = f"[dim]missing: {escape(describe_missing(first.missing))}[/]"
        else:
            note = "[dim]clean[/]"
        table.add_row(
            escape(heading), f"audio {escape(audio)}", f"subs {escape(subs)}", note
        )
    return table


def strip_all(plans: list[FilePlan], mkvmerge: str) -> list[StripResult]:
    results = []
    with progress_bars() as progress:
        overall = (
            None
            if len(plans) == 1
            else progress.add_task("stripping", total=len(plans))
        )
        for index, plan in enumerate(plans, start=1):
            if overall is not None:
                progress.update(overall, description=f"{index - 1}/{len(plans)}")
            task = progress.add_task(escape(plan.path.name), total=100)
            before = size_of(plan.path)
            ok, detail = strip_one(
                plan,
                mkvmerge,
                lambda percent, task=task: progress.update(task, completed=percent),
            )
            progress.remove_task(task)
            if not ok:
                console.print(
                    f"[failure]x[/] {escape(plan.path.name)}: {escape(detail)}"
                )
            results.append(
                StripResult(
                    plan.path, before, size_of(plan.path) if ok else before, detail
                )
            )
            if overall is not None:
                progress.advance(overall)
    return results


def build_result_table(results: list[StripResult]) -> Table:
    table = Table(box=None, pad_edge=False, show_edge=False, header_style="dim")
    table.add_column("file", overflow="ellipsis", ratio=1)
    table.add_column("before", justify="right")
    table.add_column("after", justify="right")
    table.add_column("saved", justify="right", style="success")
    for result in results:
        if result.error:
            table.add_row(
                escape(result.path.name),
                format_size(result.before),
                "[failure]failed[/]",
                "",
            )
        else:
            table.add_row(
                escape(result.path.name),
                format_size(result.before),
                format_size(result.after),
                format_size(result.saved),
            )
    if len(results) > 1:
        table.add_section()
        table.add_row(
            "[bold]total[/]",
            format_size(sum(result.before for result in results)),
            format_size(sum(result.after for result in results)),
            format_size(sum(result.saved for result in results)),
        )
    return table


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="mkv_strip_tracks",
        formatter_class=RichHelpFormatter,
        description="strip audio and subtitle tracks from mkv files, matching by language",
        epilog="pass a directory to scan it, defaults to the current one",
    )
    parser.add_argument(
        "directory", nargs="?", type=Path, default=Path("."), help="directory to scan"
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    try:
        mkvmerge = find_tool("mkvmerge")
        paths = scan_files(args.directory)
    except MkvError as error:
        print_error(str(error))
        return 1

    if not paths:
        print_error("no .mkv files found")
        return 1

    scans = probe_all(paths, mkvmerge)
    report_unreadable(scans)
    readable = [scan for scan in scans if scan.readable]
    if not readable:
        return 1

    union = union_of(readable)
    if not union:
        print_error("no audio or supported subtitle tracks found")
        return 1

    selections = choose_interactively("keep which tracks", readable, union)
    if not selections:
        console.print("[warning]nothing selected[/]")
        return 0

    plans = build_plan(readable, selections, True)
    show_panel(build_plan_table(plans), "plan")

    changing = [plan for plan in plans if plan.changes_file]
    if not changing:
        console.print(
            "[success]nothing to strip[/], every file already has only the picked tracks"
        )
        return 0

    if not confirm(f"strip {len(changing)} file(s)?"):
        print_cancelled()
        return 1

    results = strip_all(changing, mkvmerge)
    failures = sum(1 for result in results if result.error)
    saved = format_size(sum(result.saved for result in results))

    show_panel(build_result_table(results), "result")
    if failures:
        summary = f"done with {plural(failures, 'error')}"
        console.print(f"[failure]{summary}[/]")
    else:
        summary = f"done - {len(changing)} files stripped"
        console.print(f"[success]{summary}[/], saved {saved}")
    notify("mkv_strip_tracks", f"{summary}, saved {saved}")
    return 1 if failures else 0


if __name__ == "__main__":
    run_cli(main)
